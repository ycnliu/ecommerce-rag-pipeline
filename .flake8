[flake8]
max-line-length = 88
max-complexity = 10
extend-ignore = E203, W503, E501
# E203: whitespace before ':' - conflicts with black slice formatting
# W503: line break before binary operator - conflicts with black
# E501: line too long - black handles line length for code; long strings are OK
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    .venv,
    venv,
    .tox
